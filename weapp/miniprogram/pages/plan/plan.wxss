.page {
  padding: 24rpx 24rpx 60rpx;
}

.dates {
  display: flex;
  align-items: center;
}

.date {
  margin-right: 14rpx;
  padding: 12rpx 26rpx;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--sub);
  background: var(--fill);
}

.date--on {
  color: var(--card);
  background: var(--brand);
}

.dateText {
  padding: 20rpx 8rpx 8rpx;
  font-size: 34rpx;
  font-weight: 600;
}

/* ---------------- 时段 ---------------- */
.slot {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.slot__label {
  font-size: 26rpx;
  color: var(--brand-dark);
  font-weight: 600;
}

.slot__empty {
  padding: 16rpx 0 20rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.pitem {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.pitem:last-child {
  border-bottom: none;
}

.pitem__main {
  flex: 1;
}

.pitem__name {
  font-size: 28rpx;
}

.pitem__meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.pitem__del {
  padding: 8rpx 20rpx;
  font-size: 23rpx;
  color: var(--danger);
  background: var(--danger-bg);
  border-radius: var(--r-pill);
}

/* ---------------- 汇总 ---------------- */
.sum {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--brand-soft);
  border-radius: var(--r-lg);
}

.sum__row {
  display: flex;
  align-items: baseline;
}

.sum__label {
  font-size: 23rpx;
  color: var(--sub);
  margin-right: 10rpx;
}

.sum__value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand-dark);
  margin-right: 28rpx;
}

.sum__note {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--faint);
}

.sum__map {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--brand-dark);
}

/* ---------------- 收藏 ---------------- */
.sec__title {
  padding: 36rpx 8rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.fav {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.fav__main {
  flex: 1;
}

.fav__name {
  font-size: 28rpx;
}

.fav__meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.fav__add {
  padding: 12rpx 24rpx;
  font-size: 25rpx;
  color: var(--card);
  background: var(--brand);
  border-radius: var(--r-pill);
}

.fav__empty {
  padding: 24rpx 8rpx;
  font-size: 25rpx;
  color: var(--faint);
  line-height: 1.8;
}

.link {
  color: var(--brand-dark);
}
