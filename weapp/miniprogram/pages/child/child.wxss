.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 40, 32, 0.05);
}

.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #EFEDE6;
}

.row:last-child {
  border-bottom: none;
}

.row__label {
  width: 160rpx;
  font-size: 28rpx;
  color: #555C53;
}

.row__input,
.row__picker {
  flex: 1;
  font-size: 28rpx;
}

.ph {
  color: #9AA096;
}

.agehint {
  padding: 0 0 20rpx 160rpx;
  font-size: 24rpx;
  color: #3A6248;
}

.h2 {
  padding-top: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.muted {
  padding: 8rpx 0 4rpx;
  font-size: 23rpx;
  color: #9AA096;
  line-height: 1.7;
}

.opts {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.opts--wrap {
  flex-wrap: wrap;
  padding: 16rpx 0 28rpx;
}

.opt {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 26rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
  color: #555C53;
  background: #F1EFE8;
}

.opt--on {
  color: #fff;
  background: #4B7A5A;
}

.opt__note {
  font-size: 22rpx;
  color: #B9BCB2;
  margin-bottom: 16rpx;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
}

.btn--primary {
  color: #fff;
  background: #4B7A5A;
}

.btn--off {
  background: #C7D0C6;
}

.btn--danger {
  color: #B4503F;
  background: #F7ECE9;
}

.foot {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B9BCB2;
}
