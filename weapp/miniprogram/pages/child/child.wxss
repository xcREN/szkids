.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
}

.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.row:last-child {
  border-bottom: none;
}

.row__label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--sub);
}

.row__input,
.row__picker {
  flex: 1;
  font-size: 28rpx;
}

.ph {
  color: var(--faint);
}

.agehint {
  padding: 0 0 20rpx 160rpx;
  font-size: 24rpx;
  color: var(--brand-dark);
}

.h2 {
  padding-top: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.muted {
  padding: 8rpx 0 4rpx;
  font-size: 23rpx;
  color: var(--faint);
  line-height: 1.7;
}

.opts {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.opts--wrap {
  flex-wrap: wrap;
  padding: 16rpx 0 28rpx;
}

.opt {
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 26rpx;
  border-radius: var(--r);
  font-size: 25rpx;
  color: var(--sub);
  background: var(--fill);
}

.opt--on {
  color: var(--card);
  background: var(--brand);
}

.opt__note {
  font-size: 22rpx;
  color: var(--faint);
  margin-bottom: 16rpx;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  margin-top: 16rpx;
}

.btn--primary {
  color: var(--card);
  background: var(--brand);
}

.btn--off {
  background: var(--line);
}

.btn--danger {
  color: var(--danger);
  background: var(--danger-bg);
}

.foot {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
}
