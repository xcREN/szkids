page {
  background: var(--bg);
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

/* ---------------- 天气 ---------------- */
.hero {
  padding: 28rpx 28rpx 24rpx;
  border-radius: var(--r-lg);
  background: var(--brand-dark);
}

.hero__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hero__weather {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--card);
}

.hero__refresh {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero__advice {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
}

.hero__stale,
.hero__child {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.68);
}

/* ---------------- 分区 ---------------- */
.sec {
  margin-top: 36rpx;
}

.sec__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.sec__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.sec__more {
  font-size: 25rpx;
  color: var(--brand-dark);
}

.tip {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--faint);
}

/* ---------------- 候选卡片 ---------------- */
.card {
  position: relative;
  display: flex;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.card__rank {
  position: absolute;
  left: 0;
  top: 26rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--card);
  background: var(--brand);
  border-radius: 0 999rpx 999rpx 0;
}

.card__img {
  flex: none;
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--r);
  background: var(--brand-soft);
}

.card__img--ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__phemoji {
  font-size: 60rpx;
}

.card__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card__fav {
  flex: none;
  margin-left: 16rpx;
  padding: 0 8rpx;
  font-size: 34rpx;
  color: var(--faint);
}

.card__fav--on {
  color: var(--clay);
}

.card__meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--sub);
}

.card__meta--sub {
  margin-top: 4rpx;
  color: var(--faint);
}

/* ---------------- 推荐理由 ---------------- */
.reasons {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}

.reason {
  margin: 0 12rpx 8rpx 0;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
  color: var(--brand-dark);
  background: rgba(58, 98, 72, 0.10);
}

.reason--light {
  color: var(--card);
  background: rgba(255, 255, 255, 0.20);
}

/* ---------------- 摇一摇 ---------------- */
.dice {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 108rpx;
  border-radius: var(--r-lg);
  background: var(--card);
  border: 1rpx solid var(--line);
  transition: transform 0.12s ease;
}

.dice--on {
  transform: scale(0.97);
  background: var(--brand-soft);
}

.dice__emoji {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.dice__text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand-dark);
}

.dice__hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
}

.lucky {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: var(--r-lg);
  background: var(--clay-dark);
}

.lucky__tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: 21rpx;
  color: var(--clay-dark);
  background: rgba(255, 255, 255, 0.90);
}

.lucky__name {
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--card);
}

.lucky__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

/* ---------------- 页脚 ---------------- */
.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--faint);
}
