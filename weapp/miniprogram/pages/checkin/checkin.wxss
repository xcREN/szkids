.page {
  padding: 24rpx 24rpx 60rpx;
}

.head {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 24rpx;
}

.head__emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.head__name {
  font-size: 34rpx;
  font-weight: 600;
}

.head__sub {
  font-size: 23rpx;
  color: #9AA096;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 4rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 40, 32, 0.05);
}

.row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #EFEDE6;
}

.row--top {
  align-items: flex-start;
  padding: 24rpx 0;
}

.row:last-child {
  border-bottom: none;
}

.row__label {
  width: 170rpx;
  font-size: 28rpx;
  color: #555C53;
}

.row__value {
  flex: 1;
  font-size: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.opt {
  margin: 0 14rpx 14rpx 0;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #555C53;
  background: #F1EFE8;
}

.opt--on {
  color: #fff;
  background: #4B7A5A;
}

.link {
  font-size: 25rpx;
  color: #3A6248;
}

.stars {
  display: flex;
}

.star {
  font-size: 44rpx;
  color: #E8E4DC;
  margin-right: 12rpx;
}

.star--on {
  color: #D9A441;
}

.h2 {
  padding: 24rpx 0 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.note {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.ph {
  color: #9AA096;
}

.counter {
  padding: 8rpx 0 24rpx;
  text-align: right;
  font-size: 22rpx;
  color: #B9BCB2;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0 4rpx;
}

.photo {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo__img {
  width: 180rpx;
  height: 180rpx;
}

.photo__del {
  position: absolute;
  right: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: rgba(45, 40, 32, 0.5);
  border-radius: 0 16rpx 0 16rpx;
}

.photo--add {
  line-height: 180rpx;
  text-align: center;
  font-size: 44rpx;
  color: #9AA096;
  background: #F1EFE8;
}

.muted {
  padding: 4rpx 0 24rpx;
  font-size: 22rpx;
  color: #B9BCB2;
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
}

.btn--primary {
  color: #fff;
  background: #4B7A5A;
}

.btn--danger {
  color: #B4503F;
  background: #F7ECE9;
}
