.page {
  padding: 24rpx 24rpx 60rpx;
}

.head {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 24rpx;
}

.head__emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.head__name {
  font-size: 34rpx;
  font-weight: 600;
}

.head__sub {
  font-size: 23rpx;
  color: var(--faint);
}

.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 4rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
}

.row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.row--top {
  align-items: flex-start;
  padding: 24rpx 0;
}

.row:last-child {
  border-bottom: none;
}

.row__label {
  width: 170rpx;
  font-size: 28rpx;
  color: var(--sub);
}

.row__value {
  flex: 1;
  font-size: 28rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.opt {
  margin: 0 14rpx 14rpx 0;
  padding: 10rpx 24rpx;
  border-radius: var(--r-sm);
  font-size: 25rpx;
  color: var(--sub);
  background: var(--fill);
}

.opt--on {
  color: var(--card);
  background: var(--brand);
}

.link {
  font-size: 25rpx;
  color: var(--brand-dark);
}

.stars {
  display: flex;
}

.star {
  font-size: 44rpx;
  color: var(--line);
  margin-right: 12rpx;
}

.star--on {
  color: var(--gold);
}

.h2 {
  padding: 24rpx 0 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.note {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.ph {
  color: var(--faint);
}

.counter {
  padding: 8rpx 0 24rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--faint);
}

.photos {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0 4rpx;
}

.photo {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: var(--r);
  overflow: hidden;
}

.photo__img {
  width: 180rpx;
  height: 180rpx;
}

.photo__del {
  position: absolute;
  right: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--card);
  background: rgba(45, 40, 32, 0.5);
  border-radius: 0 16rpx 0 16rpx;
}

.photo--add {
  line-height: 180rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--faint);
  background: var(--fill);
}

.muted {
  padding: 4rpx 0 24rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  margin-top: 16rpx;
}

.btn--primary {
  color: var(--card);
  background: var(--brand);
}

.btn--danger {
  color: var(--danger);
  background: var(--danger-bg);
}
