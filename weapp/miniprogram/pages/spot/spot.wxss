page {
  background: #F3F1EC;
}

.page {
  padding: 20rpx 24rpx 60rpx;
}

/* ---------------- 分区 ---------------- */
.sec {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 40, 32, 0.06);
}

.sec__title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1E241F;
}

.sec__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #9AA096;
}

.req {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #B4503F;
  background: #FBEAE7;
}

/* ---------------- 地图选点 ---------------- */
.picker {
  width: 100%;
  height: 460rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
}

.coord {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.coord__v {
  font-size: 24rpx;
  color: #6C736B;
  font-family: ui-monospace, Consolas, monospace;
}

.coord__btn {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #3A6248;
  background: #E6EDE6;
}

/* ---------------- 字段 ---------------- */
.f {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid #F0EEE8;
}

.f:first-of-type {
  border-top: none;
}

.f--col {
  display: block;
}

.f__k {
  flex: none;
  font-size: 26rpx;
  color: #555C53;
}

.f__in {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 27rpx;
  color: #1E241F;
}

.f__in--full {
  margin-left: 0;
  margin-top: 12rpx;
  text-align: left;
  padding: 14rpx 18rpx;
  background: #F7F6F2;
  border-radius: 12rpx;
}

.f__ta {
  width: 100%;
  min-height: 130rpx;
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  background: #F7F6F2;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.f__pick {
  font-size: 27rpx;
  color: #3A6248;
}

/* ---------------- 分段选择 ---------------- */
.segs {
  display: flex;
  background: #F0EEE8;
  border-radius: 999rpx;
  padding: 4rpx;
}

.seg {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #6C736B;
}

.seg--on {
  background: #4B7A5A;
  color: #fff;
}

/* ---------------- 标签选择 ---------------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.chip {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #555C53;
  background: #F0EEE8;
}

.chip--on {
  background: #4B7A5A;
  color: #fff;
}

/* ---------------- 年龄 ---------------- */
.age {
  display: flex;
  align-items: center;
}

.age__in {
  width: 90rpx;
  padding: 8rpx 0;
  text-align: center;
  font-size: 27rpx;
  background: #F7F6F2;
  border-radius: 10rpx;
}

.age__sep {
  margin: 0 12rpx;
  font-size: 25rpx;
  color: #9AA096;
}

/* ---------------- 核实 ---------------- */
.verify {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FBF1E2;
}

.verify--on {
  background: #E6EDE6;
}

.verify__box {
  flex: none;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border-radius: 10rpx;
  border: 2rpx solid #C6B79A;
  background: #fff;
  text-align: center;
  line-height: 40rpx;
  font-size: 26rpx;
  color: #3A6248;
}

.verify--on .verify__box {
  border-color: #4B7A5A;
}

.verify__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1E241F;
}

.verify__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8A7A5E;
}

.verify--on .verify__desc {
  color: #55684F;
}

.verify__warn {
  display: block;
  margin-top: 4rpx;
  color: #B4503F;
}

/* ---------------- 操作 ---------------- */
.acts {
  margin-top: 28rpx;
}

.btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: #4B7A5A;
  /* 万一以后文案又变长，末尾出省略号，不要硬裁成半个字 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn::after {
  border: none;
}

.btn--cloud {
  margin-top: 18rpx;
  background: #B5714C;
}

.acts__em {
  color: #96593A;
  font-weight: 600;
}

.acts__hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9AA096;
  text-align: center;
}

.del {
  margin-top: 40rpx;
  text-align: center;
  font-size: 25rpx;
  color: #B4503F;
}
