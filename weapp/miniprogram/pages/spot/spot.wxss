page {
  background: var(--bg);
}

.page {
  padding: 20rpx 24rpx 60rpx;
}

/* ---------------- 分区 ---------------- */
.sec {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.sec__title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.sec__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--faint);
}

.req {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  font-weight: 400;
  color: var(--danger);
  background: var(--danger-bg);
}

/* ---------------- 地图选点 ---------------- */
.picker {
  width: 100%;
  height: 460rpx;
  margin-top: 16rpx;
  border-radius: var(--r);
}

.coord {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.coord__v {
  font-size: 24rpx;
  color: var(--sub);
  font-family: ui-monospace, Consolas, monospace;
}

.coord__btn {
  padding: 8rpx 22rpx;
  border-radius: var(--r-pill);
  font-size: 23rpx;
  color: var(--brand-dark);
  background: var(--brand-soft);
}

/* ---------------- 字段 ---------------- */
.f {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--fill);
}

.f:first-of-type {
  border-top: none;
}

.f--col {
  display: block;
}

.f__k {
  flex: none;
  font-size: 26rpx;
  color: var(--sub);
}

.f__in {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 27rpx;
  color: var(--text);
}

.f__in--full {
  margin-left: 0;
  margin-top: 12rpx;
  text-align: left;
  padding: 14rpx 18rpx;
  background: var(--fill);
  border-radius: var(--r-sm);
}

.f__ta {
  width: 100%;
  min-height: 130rpx;
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  background: var(--fill);
  border-radius: var(--r-sm);
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.f__pick {
  font-size: 27rpx;
  color: var(--brand-dark);
}

/* ---------------- 分段选择 ---------------- */
.segs {
  display: flex;
  background: var(--fill);
  border-radius: var(--r-pill);
  padding: 4rpx;
}

.seg {
  padding: 10rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--sub);
}

.seg--on {
  background: var(--brand);
  color: var(--card);
}

/* ---------------- 标签选择 ---------------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.chip {
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 26rpx;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--sub);
  background: var(--fill);
}

.chip--on {
  background: var(--brand);
  color: var(--card);
}

/* ---------------- 年龄 ---------------- */
.age {
  display: flex;
  align-items: center;
}

.age__in {
  width: 90rpx;
  padding: 8rpx 0;
  text-align: center;
  font-size: 27rpx;
  background: var(--fill);
  border-radius: var(--r-sm);
}

.age__sep {
  margin: 0 12rpx;
  font-size: 25rpx;
  color: var(--faint);
}

/* ---------------- 照片 ---------------- */
.sec__em {
  color: var(--clay-dark);
  font-weight: 600;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.photo {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: var(--r);
  overflow: hidden;
  background: var(--fill);
}

.photo__img {
  width: 100%;
  height: 100%;
}

.photo__del {
  position: absolute;
  right: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--card);
  background: rgba(30, 36, 31, 0.55);
  border-radius: 0 14rpx 0 14rpx;
}

.photo--add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: var(--faint);
  border: 2rpx dashed var(--line);
  background: transparent;
}

/* ---------------- 核实 ---------------- */
.verify {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: var(--r-lg);
  background: var(--warn-bg);
}

.verify--on {
  background: var(--brand-soft);
}

.verify__box {
  flex: none;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border-radius: var(--r-sm);
  border: 2rpx solid var(--warn-line);
  background: var(--card);
  text-align: center;
  line-height: 40rpx;
  font-size: 26rpx;
  color: var(--brand-dark);
}

.verify--on .verify__box {
  border-color: var(--brand);
}

.verify__title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}

.verify__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--warn);
}

.verify--on .verify__desc {
  color: var(--sub);
}

.verify__warn {
  display: block;
  margin-top: 4rpx;
  color: var(--danger);
}

/* ---------------- 操作 ---------------- */
.acts {
  margin-top: 28rpx;
}

.btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  border-radius: var(--r);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--card);
  background: var(--brand);
  /* 万一以后文案又变长，末尾出省略号，不要硬裁成半个字 */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn::after {
  border: none;
}

.btn--cloud {
  margin-top: 18rpx;
  background: var(--clay);
}

.acts__em {
  color: var(--clay-dark);
  font-weight: 600;
}

.acts__hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--faint);
  text-align: center;
}

.del {
  margin-top: 40rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--danger);
}
