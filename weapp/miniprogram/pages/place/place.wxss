.detail {
  padding-bottom: 40rpx;
}

/* ---------- 顶部大图 ---------- */
.hero {
  width: 100%;
  height: 420rpx;
}

.hero__img {
  width: 100%;
  height: 420rpx;
}

.hero--empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero__emoji {
  font-size: 96rpx;
}

.hero__note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9AA096;
}

/* ---------- 区块 ---------- */
.block {
  margin: 20rpx 24rpx;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 40, 32, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #9AA096;
}

.score {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
}

.score__num {
  font-size: 56rpx;
  font-weight: 600;
  color: #3A6248;
  line-height: 1;
}

.score__unit {
  margin-left: 6rpx;
  font-size: 26rpx;
  color: #9AA096;
}

.score__label {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #6C736B;
}

.agebox {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #E6EDE6;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.agebox__label {
  font-size: 26rpx;
  color: #555C53;
}

.agebox__val {
  font-size: 32rpx;
  font-weight: 600;
  color: #3A6248;
}

.visited {
  margin-top: 20rpx;
  padding: 14rpx 22rpx;
  background: #F1EFE8;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #555C53;
}

.tags {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
}

.tags .chip {
  margin: 0 12rpx 12rpx 0;
}

.h2 {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.reason {
  font-size: 27rpx;
  color: #555C53;
  line-height: 1.9;
}

/* ---------- 信息矩阵 ---------- */
.facts {
  display: flex;
  flex-wrap: wrap;
}

.fact {
  width: 50%;
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #555C53;
}

.fact__emoji {
  margin-right: 12rpx;
}

/* ---------- 评分行 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 27rpx;
  color: #555C53;
}

.row__stars {
  color: #D9A441;
  letter-spacing: 3rpx;
}

.row__stars--bad {
  color: #B4503F;
}

/* ---------- 地址 ---------- */
.addr {
  font-size: 27rpx;
  color: #555C53;
}

.addr__actions {
  margin-top: 20rpx;
  display: flex;
}

.addr__actions .btn + .btn {
  margin-left: 20rpx;
}

.tips {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  background: #F7F0E3;
  border-radius: 14rpx;
  font-size: 25rpx;
  color: #8A6B3D;
  line-height: 1.7;
}

.meta {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9AA096;
}

/* ---------- 按钮 ---------- */
.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn--ghost {
  color: #3A6248;
  background: #E6EDE6;
}

.btn--primary {
  color: #fff;
  background: #4B7A5A;
}

/* 已收藏：底色加深一点，和未收藏区分开 */
.btn--on {
  color: #fff;
  background: #7E9C86;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(45, 40, 32, 0.08);
}

.bar__btn {
  height: 88rpx;
  line-height: 88rpx;
}

.bar__btn + .bar__btn {
  margin-left: 20rpx;
}

.bar__pad {
  height: 140rpx;
}
