.detail {
  padding-bottom: 40rpx;
}

/* ---------- 顶部大图 ---------- */
.hero {
  width: 100%;
  height: 420rpx;
}

.hero__img {
  width: 100%;
  height: 420rpx;
}

.hero--empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero__emoji {
  font-size: 96rpx;
}

.hero__note {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--faint);
}

/* ---------- 区块 ---------- */
.block {
  margin: 20rpx 24rpx;
  padding: 32rpx 28rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--faint);
}

.score {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
}

.score__num {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--brand-dark);
  line-height: 1;
}

.score__unit {
  margin-left: 6rpx;
  font-size: 26rpx;
  color: var(--faint);
}

.score__label {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--sub);
}

.agebox {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--brand-soft);
  border-radius: var(--r);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.agebox__label {
  font-size: 26rpx;
  color: var(--sub);
}

.agebox__val {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand-dark);
}

.visited {
  margin-top: 20rpx;
  padding: 14rpx 22rpx;
  background: var(--fill);
  border-radius: var(--r);
  font-size: 24rpx;
  color: var(--sub);
}

.tags {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
}

.tags .chip {
  margin: 0 12rpx 12rpx 0;
}

.h2 {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.reason {
  font-size: 27rpx;
  color: var(--sub);
  line-height: 1.9;
}

/* ---------- 信息矩阵 ---------- */
.facts {
  display: flex;
  flex-wrap: wrap;
}

.fact {
  width: 50%;
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--sub);
}

.fact__emoji {
  margin-right: 12rpx;
}

/* ---------- 评分行 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 27rpx;
  color: var(--sub);
}

.row__stars {
  color: var(--gold);
  letter-spacing: 3rpx;
}

.row__stars--bad {
  color: var(--danger);
}

/* ---------- 地址 ---------- */
.addr {
  font-size: 27rpx;
  color: var(--sub);
}

.addr__actions {
  margin-top: 20rpx;
  display: flex;
}

.addr__actions .btn + .btn {
  margin-left: 20rpx;
}

.tips {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  background: var(--warn-bg);
  border-radius: var(--r);
  font-size: 25rpx;
  color: var(--warn);
  line-height: 1.7;
}

.open {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-sm);
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--text);
  background: var(--fill);
}

.open--unknown {
  color: var(--warn);
  background: var(--warn-bg);
}

.unverified {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: var(--r-sm);
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--warn);
  background: var(--warn-bg);
}

.meta {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--faint);
}

/* ---------- 按钮 ---------- */
.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 28rpx;
}

.btn--ghost {
  color: var(--brand-dark);
  background: var(--brand-soft);
}

.btn--primary {
  color: var(--card);
  background: var(--brand);
}

/* 已收藏：底色加深一点，和未收藏区分开 */
.btn--on {
  color: var(--card);
  background: var(--brand-mute);
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  box-shadow: var(--lift-up);
}

.bar__btn {
  height: 88rpx;
  line-height: 88rpx;
}

.bar__btn + .bar__btn {
  margin-left: 20rpx;
}

.bar__pad {
  height: 140rpx;
}
