.page {
  padding: 24rpx 40rpx 60rpx;
}

.tip {
  padding: 8rpx 8rpx 24rpx;
  font-size: 25rpx;
  color: var(--sub);
  text-align: center;
}

.stage {
  position: relative;
  width: 100%;
  height: 990rpx;
}

/* 画布和导出图同尺寸叠在一起：画布在下，图片在上 */
.card {
  position: absolute;
  left: 0;
  top: 0;
  width: 660rpx;
  height: 990rpx;
  border-radius: var(--r-lg);
  box-shadow: var(--lift);
}

.card--img {
  z-index: 2;
}

.loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 460rpx;
  z-index: 3;
  text-align: center;
  font-size: 26rpx;
  color: var(--faint);
}

.acts {
  margin-top: 40rpx;
  display: flex;
}

.btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 29rpx;
}

.btn--primary {
  color: var(--card);
  background: var(--brand);
  margin-right: 20rpx;
}

.btn--ghost {
  color: var(--brand-dark);
  background: var(--brand-soft);
}

.foot {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
}
