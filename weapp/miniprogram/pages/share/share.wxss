.page {
  padding: 24rpx 40rpx 60rpx;
}

.tip {
  padding: 8rpx 8rpx 24rpx;
  font-size: 25rpx;
  color: #6C736B;
  text-align: center;
}

.stage {
  position: relative;
  width: 100%;
  height: 990rpx;
}

/* 画布和导出图同尺寸叠在一起：画布在下，图片在上 */
.card {
  position: absolute;
  left: 0;
  top: 0;
  width: 660rpx;
  height: 990rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(45, 40, 32, 0.12);
}

.card--img {
  z-index: 2;
}

.loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 460rpx;
  z-index: 3;
  text-align: center;
  font-size: 26rpx;
  color: #9AA096;
}

.acts {
  margin-top: 40rpx;
  display: flex;
}

.btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 29rpx;
}

.btn--primary {
  color: #fff;
  background: #4B7A5A;
  margin-right: 20rpx;
}

.btn--ghost {
  color: #3A6248;
  background: #E6EDE6;
}

.foot {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B9BCB2;
}
