page,
.page {
  height: 100%;
}

.map {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* ---------------- 顶部 ---------------- */
.top {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  padding: 20rpx 24rpx 16rpx;
  /* 顶部渐变，保证地图深色区域上文字也看得清 */
  background: linear-gradient(180deg, rgba(243, 241, 236, 0.96) 62%, rgba(243, 241, 236, 0));
}

.top__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  /* 右上角是微信胶囊按钮，留出空间免得被压住 */
  padding: 0 200rpx 0 8rpx;
}

.top__city {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.top__weather {
  font-size: 24rpx;
  color: var(--faint);
}

.search {
  margin-top: 16rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: var(--card);
  border-radius: var(--r-pill);
  box-shadow: var(--lift);
}

.search__icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search__ph {
  font-size: 27rpx;
  color: var(--faint);
}

.chips {
  margin-top: 16rpx;
  white-space: nowrap;
}

.chips__inner {
  display: inline-flex;
  padding: 4rpx 2rpx 8rpx;
}

.chips__inner .fchip + .fchip {
  margin-left: 14rpx;
}

.fchip {
  padding: 12rpx 26rpx;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--sub);
  background: var(--card);
  border: 1rpx solid var(--line);
}

.fchip--on {
  background: var(--brand);
  color: var(--card);
}

/* ---------------- 列表模式 ---------------- */
.listview {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  /* top 由 wxml 按状态栏高度和横幅有无算出来 */
  background: var(--bg);
  padding: 0 20rpx;
  box-sizing: border-box;
}

.listview__count {
  padding: 20rpx 8rpx 12rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.listview__item {
  margin-bottom: 16rpx;
}

.listview__empty {
  padding: 80rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--faint);
}

.listview__pad {
  height: 40rpx;
}

/* ---------------- 悬浮按钮 ---------------- */
.fabs {
  position: absolute;
  right: 24rpx;
  bottom: 200rpx;
  transition: bottom 0.2s ease;
}

.fabs--up {
  bottom: 520rpx;
}

.fabs .fab + .fab {
  margin-top: 16rpx;
}

/* 图标用 <image> 组件，不用 CSS 背景图 ——
   小程序 WXSS 的 background-image 不支持本地路径，SVG 的 data URI
   在部分基础库上也渲染不出来（试过，结果是个空白圆圈）。
   图标由 tools/gen_assets.py 生成，改颜色改那里的 UI_ICON 再跑一次。 */
.fab__icon {
  width: 40rpx;
  height: 40rpx;
}

.fab {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: 50%;
  box-shadow: var(--lift);
}

/* ---------------- 今天去哪 ---------------- */
.today {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 116rpx;
  padding: 18rpx 40rpx;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  color: var(--card);
  background: var(--brand);
  box-shadow: var(--lift);
}

.today--hide {
  display: none;
}

/* ---------------- 底部 ---------------- */
.summary {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--sub);
}

.summary__tip {
  color: var(--faint);
}

.sheet {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 24rpx;
}

/* ---------------- 专题 / 搜索横幅 ---------------- */
.banner {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  background: rgba(58, 98, 72, 0.10);
  border-radius: var(--r-pill);
}

.banner__text {
  flex: 1;
  font-size: 24rpx;
  color: var(--brand-dark);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.banner__clear {
  margin-left: 16rpx;
  font-size: 23rpx;
  color: var(--sub);
}

/* ---------------- 搜索这片区域 ---------------- */
.region {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 340rpx;
  padding: 14rpx 32rpx;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--brand-dark);
  background: var(--card);
  box-shadow: var(--lift);
}
