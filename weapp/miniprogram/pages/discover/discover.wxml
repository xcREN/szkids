<view class="page">
  <view class="hd">
    <view class="hd__title">今天适合去哪</view>
    <view class="hd__sub">发现深圳适合孩子的每一个地方</view>
  </view>

  <view class="search" bindtap="onSearchTap">
    <text class="search__icon">🔍</text>
    <text class="search__ph">搜索公园、博物馆、玩水……</text>
  </view>

  <view class="sec">
    <view class="sec__title">🔥 本周推荐</view>
    <view wx:for="{{hot}}" wx:key="id" class="sec__item">
      <place-card place="{{item}}" mode="list" favorited="{{item.favorited}}"
                  bind:detail="onDetail" bind:favorite="onFavorite" />
    </view>
  </view>

  <view class="sec">
    <view class="sec__title">地图专题</view>
    <view wx:for="{{topics}}" wx:key="key" class="topic" data-key="{{item.key}}" bindtap="onTopicTap">
      <text class="topic__emoji">{{item.emoji}}</text>
      <text class="topic__title">{{item.title}}</text>
      <text class="topic__count">{{item.count}}</text>
      <text class="topic__arrow">›</text>
    </view>
  </view>
</view>
