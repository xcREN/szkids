.page {
  padding: 24rpx 24rpx 40rpx;
}

.hd {
  padding: 8rpx 8rpx 20rpx;
}

.hd__title {
  font-size: 40rpx;
  font-weight: 600;
}

.hd__sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--faint);
}

.sec {
  margin-top: 24rpx;
}

.sec__title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 8rpx 16rpx;
}

.sec__item {
  margin-bottom: 20rpx;
}

.topic {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 14rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.topic__emoji {
  font-size: 34rpx;
  margin-right: 18rpx;
}

.topic__title {
  flex: 1;
  font-size: 28rpx;
}

.topic__arrow {
  color: var(--faint);
  font-size: 34rpx;
}

.topic__count {
  font-size: 24rpx;
  color: var(--faint);
  margin-right: 12rpx;
}

.search {
  margin-top: 8rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: var(--card);
  border-radius: var(--r-pill);
  border: 1rpx solid var(--line);
}

.search__icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search__ph {
  font-size: 27rpx;
  color: var(--faint);
}
