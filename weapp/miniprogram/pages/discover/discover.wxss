.page {
  padding: 24rpx 24rpx 40rpx;
}

.hd {
  padding: 8rpx 8rpx 20rpx;
}

.hd__title {
  font-size: 40rpx;
  font-weight: 600;
}

.hd__sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #9AA096;
}

.sec {
  margin-top: 24rpx;
}

.sec__title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 8rpx 16rpx;
}

.sec__item {
  margin-bottom: 20rpx;
}

.topic {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 14rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 40, 32, 0.05);
}

.topic__emoji {
  font-size: 34rpx;
  margin-right: 18rpx;
}

.topic__title {
  flex: 1;
  font-size: 28rpx;
}

.topic__arrow {
  color: #B9BCB2;
  font-size: 34rpx;
}

.topic__count {
  font-size: 24rpx;
  color: #9AA096;
  margin-right: 12rpx;
}

.search {
  margin-top: 8rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 40, 32, 0.06);
}

.search__icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search__ph {
  font-size: 27rpx;
  color: #9AA096;
}
