page {
  background: var(--bg);
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

/* ---------------- 说明 ---------------- */
.intro {
  padding: 26rpx;
  border-radius: var(--r-lg);
  background: var(--brand-dark);
}

.intro__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--card);
}

.intro__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
}

.intro__admin {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

/* ---------------- 分区标题 ---------------- */
.sec__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 0 16rpx;
}

.sec__title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.sec__act {
  font-size: 25rpx;
  color: var(--brand-dark);
}

/* ---------------- 空状态 ---------------- */
.empty {
  padding: 60rpx 40rpx;
  text-align: center;
  background: var(--card);
  border-radius: var(--r-lg);
}

.empty__emoji {
  font-size: 64rpx;
}

.empty__title {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--sub);
}

.empty__desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--faint);
}

/* ---------------- 列表项 ---------------- */
.item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 22rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.item__emoji {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 34rpx;
  background: var(--fill);
  border-radius: var(--r);
}

.item__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item__top {
  display: flex;
  align-items: center;
}

.item__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tag {
  flex: none;
  margin-left: 14rpx;
  padding: 3rpx 14rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  color: var(--sub);
  background: var(--fill);
}

.tag--cloud {
  color: var(--clay-dark);
  background: var(--clay-bg);
}

.item__meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--faint);
}

.item__ok {
  color: var(--brand);
}

.item__warn {
  color: var(--danger);
}

.item__arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 30rpx;
  color: var(--faint);
}

/* ---------------- 添加 ---------------- */
.add {
  margin-top: 8rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-lg);
  font-size: 29rpx;
  font-weight: 600;
  color: var(--card);
  background: var(--brand);
}

/* ---------------- 作者工具 ---------------- */
.tools,
.setup {
  margin-top: 36rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--r-lg);
}

.tools__title,
.setup__title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}

.tools__row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--sub);
}

.tools__v {
  color: var(--text);
  font-weight: 600;
}

.tools__tip,
.setup__desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: var(--faint);
}

.tools__btns {
  display: flex;
  margin-top: 18rpx;
}

.tools__btns .tbtn + .tbtn {
  margin-left: 16rpx;
}

.tbtn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: var(--r);
  font-size: 25rpx;
  color: var(--brand-dark);
  background: var(--brand-soft);
}

.tbtn--full {
  margin-top: 14rpx;
}

/* ---------------- 首次配置引导 ---------------- */
.setup {
  background: var(--warn-bg);
}

.setup__desc {
  color: var(--warn);
}

.setup__id {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  background: var(--card);
  border-radius: var(--r-sm);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--warn);
  word-break: break-all;
  font-family: ui-monospace, Consolas, monospace;
}

/* ---------------- 页脚 ---------------- */
.foot {
  margin-top: 40rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--faint);
  text-align: center;
}
