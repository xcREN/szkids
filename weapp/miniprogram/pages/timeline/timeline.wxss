.page {
  padding: 24rpx 24rpx 40rpx;
}

.hd {
  padding: 8rpx;
}

.hd__title {
  font-size: 40rpx;
  font-weight: 600;
}

.hd__sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--faint);
}

/* ---------------- 探索度 ---------------- */
.explore {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.explore__row {
  display: flex;
  align-items: baseline;
}

.explore__num {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--brand-dark);
  line-height: 1;
}

.explore__unit {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: var(--sub);
}

.explore__pct {
  margin-left: auto;
  font-size: 25rpx;
  color: var(--sub);
}

.bar {
  margin-top: 20rpx;
  height: 14rpx;
  border-radius: var(--r-pill);
  background: var(--line-soft);
  overflow: hidden;
}

.bar__fill {
  height: 14rpx;
  border-radius: var(--r-pill);
  background: var(--brand);
}

.explore__note {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--faint);
}

/* ---------------- 地图 ---------------- */
.mapbox {
  position: relative;
  margin-top: 24rpx;
  height: 460rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
}

.map {
  width: 100%;
  height: 460rpx;
}

.legend {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  display: flex;
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.92);
}

.legend__item {
  font-size: 21rpx;
  color: var(--brand-dark);
}

.legend__item--off {
  margin-left: 16rpx;
  color: var(--faint);
}

/* ---------------- 年份 + 统计 ---------------- */
.years {
  display: flex;
  padding: 28rpx 4rpx 16rpx;
}

.year {
  margin-right: 14rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--sub);
  background: var(--fill);
}

.year--on {
  color: var(--card);
  background: var(--brand);
}

.stats {
  display: flex;
  flex-wrap: wrap;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 20rpx 0;
  border: 1rpx solid var(--line);
}

.stat {
  width: 33.33%;
  text-align: center;
  padding: 20rpx 0;
}

.stat__value {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--brand-dark);
  line-height: 1.2;
}

.stat__unit {
  font-size: 22rpx;
  margin-left: 4rpx;
  color: var(--sub);
}

.stat__label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.share {
  margin-top: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  color: var(--brand-dark);
  background: var(--brand-soft);
}

/* ---------------- 记录 ---------------- */
.sec__title {
  padding: 36rpx 8rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.rec {
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.rec__head {
  display: flex;
  align-items: baseline;
}

.rec__date {
  width: 150rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.rec__name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.rec__meta {
  display: flex;
  align-items: center;
  padding-left: 150rpx;
  margin-top: 6rpx;
}

.rec__kid {
  font-size: 23rpx;
  color: var(--sub);
}

.rec__stars {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 2rpx;
}

.rec__note {
  margin: 14rpx 0 0 150rpx;
  font-size: 26rpx;
  color: var(--sub);
  line-height: 1.7;
}

.rec__photos {
  display: flex;
  margin: 16rpx 0 0 150rpx;
}

.rec__photo {
  width: 140rpx;
  height: 140rpx;
  margin-right: 12rpx;
  border-radius: var(--r-sm);
}

.btn {
  margin: 36rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  color: var(--card);
  background: var(--brand);
}
