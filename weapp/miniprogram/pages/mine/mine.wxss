.page {
  padding: 24rpx 24rpx 40rpx;
}

/* ---------------- 头像昵称 ---------------- */
.profile {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--brand-soft);
}

.avatar--empty {
  line-height: 112rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--brand);
}

.profile__text {
  flex: 1;
}

.profile__nick {
  font-size: 32rpx;
  font-weight: 600;
  height: 48rpx;
}

.ph {
  color: var(--faint);
  font-weight: 400;
}

.profile__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--faint);
}

/* ---------------- 孩子 ---------------- */
.sec {
  margin-top: 32rpx;
}

.sec__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.sec__title {
  font-size: 28rpx;
  font-weight: 600;
}

.sec__action {
  font-size: 26rpx;
  color: var(--brand-dark);
}

.kids {
  display: flex;
  flex-wrap: wrap;
}

.kid {
  position: relative;
  width: 47%;
  margin: 0 3% 20rpx 0;
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 2rpx solid transparent;
  border: 1rpx solid var(--line);
}

.kid--on {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.kid__row {
  display: flex;
  align-items: center;
}

.kid__name {
  font-size: 30rpx;
  font-weight: 600;
}

.kid__badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  color: var(--card);
  background: var(--brand);
}

.kid__age {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--sub);
}

.kid__edit {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 23rpx;
  color: var(--brand-dark);
}

.addcard {
  padding: 32rpx 28rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.addcard__title {
  font-size: 28rpx;
  font-weight: 600;
}

.addcard__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--faint);
  line-height: 1.7;
}

/* ---------------- 入口列表 ---------------- */
.list {
  margin-top: 32rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  overflow: hidden;
  border: 1rpx solid var(--line);
}

.item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.item:last-child {
  border-bottom: none;
}

.item__emoji {
  width: 56rpx;
  font-size: 32rpx;
}

.item__text {
  flex: 1;
}

.item__title {
  font-size: 28rpx;
}

.item__desc {
  font-size: 23rpx;
  color: var(--faint);
}

.item__right {
  font-size: 25rpx;
  color: var(--faint);
}

.item__phase {
  font-size: 22rpx;
  color: var(--faint);
}

/* ---------------- 联系方式 ---------------- */
.contact {
  margin-top: 32rpx;
  padding: 28rpx 28rpx 12rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

.contact__title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}

.contact__desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--faint);
}

.contact__row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line-soft);
}

.contact__label {
  flex: none;
  width: 80rpx;
  font-size: 25rpx;
  color: var(--faint);
}

.contact__value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.contact__act {
  flex: none;
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  font-size: 23rpx;
  color: var(--brand-dark);
  background: var(--brand-soft);
}

.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
}
