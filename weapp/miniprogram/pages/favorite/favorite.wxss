.page {
  padding: 16rpx 24rpx 40rpx;
}

.tabs {
  white-space: nowrap;
}

.tabs__inner {
  display: inline-flex;
  padding: 8rpx 0;
}

.tab {
  margin-right: 14rpx;
  padding: 12rpx 26rpx;
  border-radius: var(--r-pill);
  font-size: 25rpx;
  color: var(--sub);
  background: var(--fill);
}

.tab--on {
  color: var(--card);
  background: var(--brand);
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx 12rpx;
}

.bar__count {
  font-size: 25rpx;
  color: var(--faint);
}

.bar__map {
  font-size: 26rpx;
  color: var(--brand-dark);
}

.item {
  margin-bottom: 24rpx;
}

.folder {
  display: flex;
  align-items: center;
  margin: -6rpx 8rpx 0;
  padding: 14rpx 20rpx;
  background: var(--line-soft);
  border-radius: 0 0 20rpx 20rpx;
}

.folder__label {
  font-size: 23rpx;
  color: var(--faint);
}

.folder__name {
  flex: 1;
  margin-left: 16rpx;
  font-size: 25rpx;
  color: var(--sub);
}

.folder__arrow {
  color: var(--faint);
  font-size: 30rpx;
}

.btn {
  margin: 36rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  color: var(--card);
  background: var(--brand);
}
