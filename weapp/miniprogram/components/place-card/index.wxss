.pcard {
  position: relative;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 32rpx 28rpx 28rpx;
}

/* 地图模式是真的浮在地图上，这时候才需要阴影 */
.pcard--map {
  box-shadow: var(--lift);
}

/* 列表模式在页面流里，1rpx 边框分层就够了 */
.pcard--list {
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--line);
}

.pcard__close {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--faint);
  font-size: 28rpx;
}

.pcard__head {
  display: flex;
  align-items: center;
}

.pcard__emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.pcard__name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text);
}

.pcard__score {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.pcard__stars {
  color: var(--gold);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.pcard__scorenum {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.pcard__district {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.pcard__age {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
}

.pcard__agelabel {
  font-size: 24rpx;
  color: var(--sub);
}

.pcard__ageval {
  margin-left: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand-dark);
}

.pcard__tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}

/* 用 margin 代替 flex gap：部分安卓微信 WebView 不支持 gap */
.pcard__tags .chip {
  margin: 0 12rpx 12rpx 0;
}

.pcard__facts {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  font-size: 26rpx;
  color: var(--sub);
}

.pcard__fact {
  margin: 0 24rpx 4rpx 0;
}

.pcard__actions {
  margin-top: 28rpx;
  display: flex;
}

.pcard__actions .pcard__btn + .pcard__btn {
  margin-left: 20rpx;
}

.pcard__btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 28rpx;
  color: var(--brand-dark);
  background: var(--brand-soft);
}

.pcard__btn--primary {
  color: var(--card);
  background: var(--brand);
}

/* .chip 在 app.wxss 里定义过，组件内再写一份，
   免得样式隔离策略变化时标签样式丢失 */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: var(--r-pill);
  font-size: 24rpx;
  color: var(--sub);
  background: var(--line-soft);
  white-space: nowrap;
}
